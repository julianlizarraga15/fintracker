FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
COPY backend/requirements-broker-lambda.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-broker-lambda.txt

COPY backend /app/backend
COPY infra/binance /app/infra/binance
COPY scripts /app/scripts

ENV PYTHONPATH=/app
ENV PYTHON_DOTENV_DISABLED=1
ENV ACCOUNT_EMAIL=pytest@example.invalid

CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "backend/tests"]
